{
  "permissions": {
    "defaultMode": "manual",
    "deny": ["Edit(./data/raw/**)", "Read(./data/raw/loyalty_members.csv)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/run_tests.py"
          }
        ]
      }
    ]
  }
}
